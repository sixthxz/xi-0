{
  "_nota": "Plantilla con un proyecto de ejemplo (api en .NET, spa en Angular). Cópiala a <repo>/.claude/xi-0/config.json y ajusta carpetas, comandos, verificacion, qa_visual y no_leer a tu repo. Para un proyecto de Node de un solo paquete hay una más corta: config.node.json.",
  "proyecto": "<nombre>",
  "worktrees": "../<nombre>.worktrees",
  "rama_base": "main",
  "remoto": {
    "_nota": "Así nada sale de esta máquina. Para subir la rama y abrir el PR: push=true, remote_permitido=<nombre del remoto>, pr=true, repo_pr=<usuario>/<repo>.",
    "push": false,
    "remote_permitido": null,
    "pr": false,
    "repo_pr": null,
    "merge": false
  },
  "verificacion": {
    "api": [
      "dotnet tool restore",
      "dotnet csharpier check .",
      "dotnet build MiApp.sln --configuration Release",
      "dotnet test MiApp.sln --configuration Release"
    ],
    "spa": [
      "npm ci",
      "npm run test:scripts",
      "npx ng test --watch=false",
      "npm run build"
    ]
  },
  "qa_visual": {
    "_nota": "Opcional, solo si el proyecto tiene interfaz web. Pide npm install en ~/.claude/xi-0/qa-visual. Sin esta clave no hay capturas y QA escribe \"visual: no aplica\".",
    "url_publicada": null,
    "build": "npm run build",
    "dist": "spa/dist/mi-app/browser"
  },
  "no_leer": [
    "spa/src/data/**"
  ],
  "carpetas": {
    "xi-0": [
      ".xi-0/estado.md",
      ".xi-0/tarea.md",
      ".xi-0/metricas.md",
      ".claude/xi-0/activa.json"
    ],
    "norte": [],
    "yunque": [
      ".xi-0/PR.md"
    ],
    "meridiano": [],
    "atlas": [
      ".xi-0/plan/investigacion/**"
    ],
    "brujula": [
      ".xi-0/plan/requisitos/**"
    ],
    "lumen": [
      ".xi-0/plan/diseno/**"
    ],
    "plano": [
      ".xi-0/plan/arq/**",
      ".xi-0/contratos/**"
    ],
    "sextante": [
      ".xi-0/plan/herramientas/**",
      ".xi-0/permisos.json"
    ],
    "prisma": {
      "incluye": [
        "spa/src/app/**",
        "spa/src/scss/**",
        "spa/src/assets/**",
        "spa/src/utils/**",
        "spa/src/*.ts",
        "spa/src/*.html",
        "spa/angular.json",
        "spa/tsconfig*.json",
        "spa/package.json",
        "spa/package-lock.json"
      ],
      "excluye": [
        "**/*.spec.ts"
      ]
    },
    "forja": {
      "incluye": [
        "api/**",
        "spa/scripts/**",
        "spa/src/data/**"
      ],
      "excluye": [
        "api/tests/**",
        "api/Run-*",
        "api/global.json",
        "api/dotnet-tools.json",
        "api/README.md",
        "spa/scripts/*.test.js"
      ]
    },
    "argos": [
      "api/tests/**",
      "**/*.spec.ts",
      "spa/scripts/*.test.js",
      ".xi-0/qa/**",
      ".xi-0/fallas/qa-*"
    ],
    "egida": [
      ".xi-0/seguridad/**",
      ".xi-0/fallas/seg-*"
    ],
    "faro": [
      ".github/**",
      "api/Run-*",
      "api/global.json",
      "api/dotnet-tools.json",
      ".gitignore",
      ".gitattributes",
      ".xi-0/despliegue/**"
    ],
    "codice": [
      "README.md",
      "api/README.md",
      "spa/README.md",
      ".xi-0/docs/**"
    ]
  },
